APP_NAME=Zonagim
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=zonagim_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_SECURE_COOKIE=false
# Produksi HTTPS: set true dan gunakan domain resmi.
# SESSION_SECURE_COOKIE=true
# SESSION_DOMAIN=zonagim.my.id
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@zonagim.my.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Chatbot AI (Groq)
GROQ_API_KEY=

# Cloudflare Turnstile (captcha)
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=localhost

# Isi IP/CIDR reverse proxy tepercaya, dipisahkan koma. Kosongkan bila tanpa proxy.
TRUSTED_PROXIES=

SEO_URL=https://zonagim.my.id
# Kontak dan akun sosial resmi. Isi hanya jika sudah aktif.
SEO_WHATSAPP=
SEO_TWITTER=
# Opsional: URL media sosial resmi (schema Organization > sameAs)
# SEO_INSTAGRAM=
# SEO_TIKTOK=
# SEO_FACEBOOK=
# SEO_YOUTUBE=
